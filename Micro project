class Song:
    """Node of the doubly linked list."""
    def __init__(self, title, artist, duration):
        self.title = title
        self.artist = artist
        self.duration = duration      # in seconds
        self.prev = None
        self.next = None


class Playlist:
    def __init__(self):
        self.head = None
        self.tail = None
        self.current = None
        self.size = 0

    @staticmethod
    def fmt(sec):
        return f"{sec // 60}:{sec % 60:02d}"

    # ---------- insertion ----------
    def add_last(self, title, artist, duration):
        node = Song(title, artist, duration)
        if self.head is None:
            self.head = self.tail = self.current = node
        else:
            node.prev = self.tail
            self.tail.next = node
            self.tail = node
        self.size += 1
        print(f"'{title}' added to the end of the playlist.")

    def add_first(self, title, artist, duration):
        node = Song(title, artist, duration)
        if self.head is None:
            self.head = self.tail = self.current = node
        else:
            node.next = self.head
            self.head.prev = node
            self.head = node
        self.size += 1
        print(f"'{title}' added to the beginning of the playlist.")

    def insert_at(self, pos, title, artist, duration):
        if pos < 1 or pos > self.size + 1:
            print("Invalid position!")
            return
        if pos == 1:
            return self.add_first(title, artist, duration)
        if pos == self.size + 1:
            return self.add_last(title, artist, duration)
        temp = self.head
        for _ in range(pos - 2):
            temp = temp.next
        node = Song(title, artist, duration)
        node.next = temp.next
        node.prev = temp
        temp.next.prev = node
        temp.next = node
        self.size += 1
        print(f"'{title}' inserted at position {pos}.")

    # ---------- deletion ----------
    def delete_song(self, title):
        temp = self.head
        while temp and temp.title.lower() != title.lower():
            temp = temp.next
        if temp is None:
            print(f"Song '{title}' not found.")
            return
        if temp.prev:
            temp.prev.next = temp.next
        else:
            self.head = temp.next
        if temp.next:
            temp.next.prev = temp.prev
        else:
            self.tail = temp.prev
        if self.current is temp:
            self.current = temp.next if temp.next else self.head
        self.size -= 1
        print(f"'{temp.title}' deleted from the playlist.")

    # ---------- searching / display ----------
    def search_song(self, title):
        temp, pos = self.head, 1
        while temp:
            if temp.title.lower() == title.lower():
                print(f"Found at position {pos}: {temp.title} - {temp.artist} [{self.fmt(temp.duration)}]")
                return
            temp, pos = temp.next, pos + 1
        print(f"Song '{title}' not found.")

    def display(self):
        if self.head is None:
            print("Playlist is empty.")
            return
        print("\n--- Playlist (forward) ---")
        temp, pos = self.head, 1
        while temp:
            mark = "  <-- now playing" if temp is self.current else ""
            print(f"{pos}. {temp.title} - {temp.artist} [{self.fmt(temp.duration)}]{mark}")
            temp, pos = temp.next, pos + 1

    def display_reverse(self):
        if self.tail is None:
            print("Playlist is empty.")
            return
        print("\n--- Playlist (reverse) ---")
        temp, pos = self.tail, self.size
        while temp:
            print(f"{pos}. {temp.title} - {temp.artist}")
            temp, pos = temp.prev, pos - 1

    # ---------- playback ----------
    def play_current(self):
        if self.current is None:
            print("Playlist is empty.")
        else:
            print(f"Now playing: {self.current.title} - {self.current.artist} [{self.fmt(self.current.duration)}]")

    def play_next(self):
        if self.current is None:
            print("Playlist is empty.")
        elif self.current.next is None:
            print("End of playlist reached.")
        else:
            self.current = self.current.next
            self.play_current()

    def play_previous(self):
        if self.current is None:
            print("Playlist is empty.")
        elif self.current.prev is None:
            print("Already at the first song.")
        else:
            self.current = self.current.prev
            self.play_current()

    def total_duration(self):
        total, temp = 0, self.head
        while temp:
            total += temp.duration
            temp = temp.next
        print(f"Total songs: {self.size} | Total duration: {self.fmt(total)}")


def read_duration():
    m, s = input("Enter duration (mm:ss): ").split(":")
    return int(m) * 60 + int(s)


def main():
    pl = Playlist()
    while True:
        print("\n===== MUSIC PLAYLIST MANAGER =====")
        print("1. Add song at end        2. Add song at beginning")
        print("3. Insert at position     4. Delete song")
        print("5. Search song            6. Display playlist")
        print("7. Display in reverse     8. Play next")
        print("9. Play previous          10. Now playing")
        print("11. Total duration        12. Exit")
        ch = input("Enter your choice: ").strip()
        if ch in ("1", "2", "3"):
            pos = int(input("Enter position: ")) if ch == "3" else None
            title = input("Enter song title: ")
            artist = input("Enter artist name: ")
            dur = read_duration()
            if ch == "1":
                pl.add_last(title, artist, dur)
            elif ch == "2":
                pl.add_first(title, artist, dur)
            else:
                pl.insert_at(pos, title, artist, dur)
        elif ch == "4":
            pl.delete_song(input("Enter song title to delete: "))
        elif ch == "5":
            pl.search_song(input("Enter song title to search: "))
        elif ch == "6":
            pl.display()
        elif ch == "7":
            pl.display_reverse()
        elif ch == "8":
            pl.play_next()
        elif ch == "9":
            pl.play_previous()
        elif ch == "10":
            pl.play_current()
        elif ch == "11":
            pl.total_duration()
        elif ch == "12":
            print("Exiting Music Playlist Manager. Goodbye!")
            break
        else:
            print("Invalid choice! Try again.")


if __name__ == "__main__":
    main()
